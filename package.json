{
  "name": "brass-birmingham",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "rules:generate:ruleset": "node scripts/rules/build-ruleset-data.mjs",
    "rules:generate:cards": "node scripts/rules/build-card-data.mjs",
    "rules:generate:industry": "node scripts/rules/build-industry-data.mjs",
    "rules:generate:board": "node scripts/rules/build-board-topology.mjs",
    "rules:generate": "pnpm rules:generate:ruleset && pnpm rules:generate:cards && pnpm rules:generate:industry && pnpm rules:generate:board",
    "rules:check:ruleset": "node scripts/rules/build-ruleset-data.mjs --check",
    "rules:check:cards": "node scripts/rules/build-card-data.mjs --check",
    "rules:check:industry": "node scripts/rules/build-industry-data.mjs --check",
    "rules:check:board": "node scripts/rules/build-board-topology.mjs --check",
    "rules:check": "pnpm rules:check:ruleset && pnpm rules:check:cards && pnpm rules:check:industry && pnpm rules:check:board",
    "verify": "pnpm rules:check && pnpm lint && pnpm typecheck && pnpm test",
    "check": "pnpm verify && pnpm build"
  },
  "dependencies": {
    "next": "15.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9",
    "eslint-config-next": "15.5.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "yaml": "^2.8.2"
  }
}
